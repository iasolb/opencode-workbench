{
  "$schema": "https://opencode.ai/config.json",
  // Models come from opencode Zen, the built-in hosted provider: no provider
  // block is needed, and the id format is `opencode/<model-id>`
  // (https://opencode.ai/docs/models).
  //
  // THE FREE MODEL LIST ROTATES. Probe it before relying on this line:
  //   curl -s --max-time 20 https://opencode.ai/zen/v1/models
  // Free ones are suffixed `-free` (a naming convention, NOT a documented
  // contract: the endpoint returns no pricing field). Measured 2026-08-21:
  // Big Pickle had already lost its free suffix while the Zen docs still
  // described it as free.
  //
  // Deliberately no `small_model`: one model, one place to change it.
  "model": "opencode/muse-spark-1.2-contributor-free",
  "username": "<you>",
  "instructions": ["<absolute path to this repo>/instructions.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "ollama *": "allow",
      "docker ps *": "allow",
      "docker start *": "allow",
      "docker stop *": "allow",
      "docker compose up -d *": "allow"
    },
    "external_directory": {
      "*": "ask",
      "<your memory bank repo>/**": "allow",
      "<your projects root>/**": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow"
  },
  "mcp": {
    // Replace the command with your own GitHub MCP launcher.
    "github": {
      "type": "local",
      "command": ["cmd", "/c", "<absolute path to your github-mcp launcher>"],
      "timeout": 15000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp", "--browser", "chrome"],
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "timeout": 15000
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "cwd": "<absolute path to this repo>/data",
      "timeout": 15000
    },
    "fetch": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "mcp-server-fetch"],
      "timeout": 30000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "<your projects root>",
        "<your memory bank repo>"
      ],
      "timeout": 15000
    },
    // Optional, credential-bearing MCPs. The owner's live config adds gmail,
    // google-workspace (OAuth keys file), a project MySQL server, a research
    // postgres, and Desktop Commander. All carry secrets or absolute paths, so
    // they stay out of this public repo: copy the shape from the live config
    // on the machine that already has them, or see docs/troubleshooting.md.
    "windows": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@wonderwhy-er/desktop-commander@latest"],
      "enabled": true,
      "timeout": 60000
    }
  }
}