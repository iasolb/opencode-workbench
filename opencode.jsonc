{
  "$schema": "https://opencode.ai/config.json",
  // Models come from opencode Zen, the built-in hosted provider: no provider
  // block is needed, and the id format is `opencode/<model-id>`
  // (https://opencode.ai/docs/models).
  //
  // THE FREE MODEL LIST ROTATES. Probe it before relying on this line:
  //   curl -s --max-time 20 https://opencode.ai/zen/v1/models
  // Free ones are suffixed `-free` (a naming convention, NOT a documented
  // contract: the endpoint returns no pricing field). Measured 2026-08-21:
  // Big Pickle had already lost its free suffix while the Zen docs still
  // described it as free.
  //
  // Deliberately no `small_model`: one model, one place to change it.
  "model": "opencode/muse-spark-1.2-contributor-free",
  "username": "<you>",
  "instructions": ["<absolute path to this repo>/instructions.md"],
  "permission": {
    // ORDER MATTERS: opencode evaluates the LAST matching rule. Broad first,
    // narrow/deny last, so `*: ask` MUST stay first and the denies MUST stay
    // after the broader allows they carve out of. NOT hot-reloaded: restart
    // opencode to load a change.
    // EVERY SUBCOMMAND OF A PIPELINE NEEDS ITS OWN MATCH. An allowed `git *`
    // does not carry what it pipes into: `git ... | head -40` prompts, and the
    // dialog names `head -40` as a separate shell command.
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "wsl *": "allow",
      // Per-host, matching a known-good host list, rather than a blanket
      // `ssh *`. Add one line per alias you actually use.
      "ssh <your host alias> *": "allow",
      "scp *": "allow",
      "tailscale file get *": "allow",
      "tailscale status": "allow",
      "tailscale status *": "allow",
      "tailscale version": "allow",
      "tailscale version *": "allow",
      // `up`/`down`/`set`/`serve` deliberately stay out.
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker start *": "allow",
      "docker stop *": "allow",
      "docker rm *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker exec *": "allow",
      "docker info": "allow",
      "docker compose *": "allow",
      // POSIX read-only text tools. THIS IS THE FAMILY EVERY PORT FORGETS.
      // Claude Code has a built-in read-only set and gives these away free, so
      // they appear in no allowlist you might copy from; opencode has no such
      // set and asks for every command that matches no entry. Each of these
      // reads and cannot write: `sed` (-i), `awk`, and `find` (-delete/-exec)
      // are deliberately excluded.
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "du *": "allow",
      "df *": "allow",
      "jq *": "allow",
      // `mkdir` is a WRITE command and sits outside the read-only family above
      // on purpose. Allowed anyway, on one argument: `"edit": "allow"` is set
      // below, so a session can already create and write FILES anywhere the
      // directory rules permit, and creating a directory is strictly less
      // powerful. It cannot delete or overwrite. NOT a precedent for `rm`,
      // `mv` or `cp`: those destroy or relocate, and each needs its own call.
      "mkdir *": "allow",
      // Read-only PowerShell cmdlets, for a Windows host. ForEach-Object and
      // Where-Object are deliberately out: they take scriptblocks.
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Get-Item *": "allow",
      "Get-ItemProperty *": "allow",
      "Test-Path *": "allow",
      "Get-Command *": "allow",
      "Get-Process *": "allow",
      "Get-Service *": "allow",
      "Select-String *": "allow",
      "Select-Object *": "allow",
      "Sort-Object *": "allow",
      "Measure-Object *": "allow",
      "Group-Object *": "allow",
      "Format-Table *": "allow",
      "Format-List *": "allow",
      "Out-String *": "allow",
      // Your own interpreters and scripts go here, by ABSOLUTE path. A bare
      // `python`/`pytest`/`npm` matches nothing. Anything destructive gets an
      // EXACT match with no wildcard, so its arguments cannot be swapped.
      //
      // WRITE EVERY SPELLING YOU MIGHT TYPE. A command entry prefix-matches the
      // literal string, so on Windows a backslash entry does not cover the
      // `/c/...` form that a POSIX-flavoured session actually emits.
      "<absolute path to your interpreter> *": "allow",
      // VENV BOOTSTRAP, the one blessed bare-interpreter form: the shell-form
      // guard carves `-m venv` out of its bare-interpreter rule on purpose,
      // because you cannot use a venv's own interpreter before it exists. If
      // the allowlist does not agree with the guard, the one form the guard
      // blesses is the one that prompts. Narrow: `-m venv` creates a directory
      // and cannot execute arbitrary code. A bare `python *` stays forbidden.
      "python -m venv *": "allow",
      "python3 -m venv *": "allow",
      // The GitHub-writes gate. `gh *` above is broad, so these carve the
      // remote-mutating calls back out: opening a PR is fine, merging it and
      // anything that publishes is the owner's. Removing a line here is a
      // decision, not cleanup.
      "gh pr merge *": "deny",
      "gh issue create *": "deny",
      "gh issue comment *": "deny",
      "gh release create *": "deny",
      "gh api *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "<your memory bank repo>/**": "allow",
      "<your projects root>/**": "allow",
      // The three directories opencode OWNS. Without these it asks permission
      // to reach its own scratch space, its own config and its own staged tool
      // output, which is pure friction with nothing to decide.
      "~/AppData/Local/Temp/opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow"
  },
  "mcp": {
    // Replace the command with your own GitHub MCP launcher.
    "github": {
      "type": "local",
      "command": ["cmd", "/c", "<absolute path to your github-mcp launcher>"],
      "timeout": 15000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp", "--browser", "chrome"],
      "timeout": 60000
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "timeout": 15000
    },
    "memory": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"],
      "cwd": "<absolute path to this repo>/data",
      "timeout": 15000
    },
    "fetch": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "mcp-server-fetch"],
      "timeout": 30000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "<your projects root>",
        "<your memory bank repo>"
      ],
      "timeout": 15000
    },
    // Optional, credential-bearing MCPs. The owner's live config adds gmail,
    // google-workspace (OAuth keys file), a project MySQL server, a research
    // postgres, and Desktop Commander. All carry secrets or absolute paths, so
    // they stay out of this public repo: copy the shape from the live config
    // on the machine that already has them, or see docs/troubleshooting.md.
    "windows": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@wonderwhy-er/desktop-commander@latest"],
      "enabled": true,
      "timeout": 60000
    }
  }
}